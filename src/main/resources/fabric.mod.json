{
  "schemaVersion": 1,
  "id": "projectilepreview",
  "version": "${version}",
  "name": "ProjectilePreview",
  "description": "Shows predicted projectile flight paths and impact points.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "dev.duels.projectilepreview.client.ProjectilepreviewDataGenerator"
    ],
    "client": [
      "dev.duels.projectilepreview.client.ProjectilepreviewClient"
    ],
    "modmenu": [
      "dev.duels.projectilepreview.client.ModMenuIntegration"
    ],
    "main": [
      "dev.duels.projectilepreview.Projectilepreview"
    ]
  },
  "mixins": [
    "projectilepreview.mixins.json",
    {
      "config": "projectilepreview.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
